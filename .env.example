# ============================================================
# BusTrack Backend — Environment Variables
# QUAN TRỌNG: KHÔNG commit file này lên Git!
# Thêm .env vào .gitignore ngay!
# ============================================================

# --- MongoDB ---
# Cách 1: MongoDB Atlas (đám mây - khuyến nghị)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bustrack?retryWrites=true&w=majority

# Cách 2: MongoDB local (chạy trên máy tính)
# MONGO_URI=mongodb://localhost:27017/bustrack

# --- Server ---
PORT=5000
NODE_ENV=development

# --- JWT (dùng sau cho xác thực) ---
JWT_SECRET=bustrack_super_secret_key_2026_change_this
JWT_EXPIRES_IN=7d

# --- Telegram Bot ---
# Bước 1: Mở Telegram → tìm @BotFather → gõ /newbot → làm theo hướng dẫn
# Bước 2: Sao chép token BotFather cấp, dán vào đây
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID bên dưới dùng để TEST thủ công.
# Trong production, chat_id của từng phụ huynh được lưu vào DB (User.telegram_chat_id).
TELEGRAM_CHAT_ID=your_personal_chat_id_for_testing
